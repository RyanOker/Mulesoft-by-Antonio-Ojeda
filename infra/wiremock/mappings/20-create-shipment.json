    "headers": { "X-Api-Key": { "equalTo": "fastship-local-key" } }
  },
  "response": {
    "status": 201,
    "headers": { "Content-Type": "application/json" },
    "bodyFileName": "shipment-created.json",
    "transformers": ["response-template"]
  }
}
